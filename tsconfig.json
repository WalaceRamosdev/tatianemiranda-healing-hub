{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ]
        },
        "skipLibCheck": true,
        "allowJs": true,
        "moduleResolution": "bundler",
        "isolatedModules": true,
        "noEmit": true
    },
    "exclude": [
        "dist",
        "_old_project"
    ]
}