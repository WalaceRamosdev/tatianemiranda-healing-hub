---
const steps = [
    {
        icon: "message",
        step: "01",
        title: "Primeiro Contato",
        desc: "Um breve diálogo inicial via WhatsApp para entender suas necessidades e tirar dúvidas sobre o processo.",
    },
    {
        icon: "camera",
        step: "02",
        title: "Agendamento",
        desc: "Escolhemos o melhor horário para você. Atendimentos realizados de forma online no conforto do seu lar ou presencial.",
    },
    {
        icon: "flower",
        step: "03",
        title: "Sessões Regulares",
        desc: "Sessões semanais de 50 minutos focadas no seu processo de cura, autodescoberta e fortalecimento emocional.",
    },
];

const icons = {
    message:
        '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/><path d="M8 12h.01"/><path d="M12 12h.01"/><path d="M16 12h.01"/>',
    camera: '<path d="m22 8-6 4 6 4V8Z"/><rect width="14" height="12" x="2" y="6" rx="2" ry="2"/>',
    flower: '<path d="M12 7.5a4.5 4.5 0 1 1 4.5 4.5M12 7.5A4.5 4.5 0 1 0 7.5 12M12 7.5V12m0 0a4.5 4.5 0 1 0 4.5 4.5M12 12a4.5 4.5 0 1 1-4.5 4.5M12 12v12"/>',
};
---

<section
    id="como-funciona"
    class="section-padding bg-background relative overflow-hidden"
>
    <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center mb-24">
            <span
                class="text-primary font-body text-sm font-bold uppercase tracking-[0.3em] mb-4 block"
                >Processo</span
            >
            <h2 class="font-heading text-4xl md:text-5xl text-primary mb-6">
                Sua jornada passo a passo
            </h2>
            <p class="font-body text-lg text-muted-foreground">
                A decisão de começar a terapia é o passo mais importante. Todo o
                restante foi pensado para ser leve e acolhedor.
            </p>
        </div>

        <div class="grid md:grid-cols-3 gap-16 max-w-5xl mx-auto relative">
            {/* Decorative center line for desktop */}
            <div
                class="hidden md:block absolute top-[60px] left-[15%] right-[15%] h-0.5 bg-gradient-to-r from-transparent via-primary/20 to-transparent -z-10"
            >
            </div>

            {
                steps.map((s, i) => (
                    <div class="text-center group">
                        <div class="relative inline-block mb-10">
                            <div class="w-28 h-28 rounded-[40px] bg-secondary flex items-center justify-center border-2 border-primary/5 group-hover:bg-primary group-hover:rotate-[15deg] transition-all duration-500 shadow-sm group-hover:shadow-xl">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="36"
                                    height="36"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="text-primary group-hover:text-white transition-colors duration-500 group-hover:-rotate-[15deg]"
                                    set:html={
                                        icons[s.icon as keyof typeof icons]
                                    }
                                />
                            </div>
                            <span class="absolute -top-3 -right-3 w-10 h-10 rounded-full bg-white text-primary border border-primary/10 shadow-lg text-sm font-heading flex items-center justify-center font-bold">
                                {s.step}
                            </span>
                        </div>
                        <h3 class="font-heading text-2xl text-primary mb-4 group-hover:scale-110 transition-transform">
                            {s.title}
                        </h3>
                        <p class="font-body text-base text-muted-foreground leading-relaxed max-w-[280px] mx-auto">
                            {s.desc}
                        </p>
                    </div>
                ))
            }
        </div>

        <div
            class="mt-24 p-10 rounded-[50px] bg-primary/5 border border-primary/10 max-w-4xl mx-auto text-center"
        >
            <h4 class="font-heading text-2xl text-primary mb-4 italic">
                "O autoconhecimento é o começo de toda sabedoria."
            </h4>
            <p class="font-body text-muted-foreground">— Aristóteles</p>
        </div>
    </div>
</section>
