---
const year = new Date().getFullYear();
---

<footer class="footer">
    <div class="container footer-content">
        <div class="footer-info">
            <h2 class="footer-logo font-display">Tatiane Miranda</h2>
            <p class="footer-crp">Psicóloga Clínica | CRP-10/11768</p>
            <p class="footer-bio">
                Ofereço um espaço seguro, acolhedor e livre de julgamentos para
                adolescentes e adultos, focado na transformação e no bem-estar
                emocional.
            </p>
        </div>

        <div class="footer-links">
            <h3>Links Rápidos</h3>
            <ul>
                <li><a href="/sobre">Sobre mim</a></li>
                <li><a href="/atendimento">Atendimento</a></li>
                <li><a href="/duvidas">Dúvidas</a></li>
                <li><a href="/dicas">Dicas</a></li>
                <li><a href="/feedback">Feedback</a></li>
            </ul>
        </div>

        <div class="footer-social">
            <h3>Redes Sociais</h3>
            <div class="social-icons">
                <a
                    href="https://instagram.com"
                    target="_blank"
                    aria-label="Instagram"
                >
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><rect x="2" y="2" width="20" height="20" rx="5" ry="5"
                        ></rect><path
                            d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                        ></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"
                        ></line></svg
                    >
                </a>
                <a
                    href="https://facebook.com"
                    target="_blank"
                    aria-label="Facebook"
                >
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path
                            d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
                        ></path></svg
                    >
                </a>
                <a
                    href="mailto:contato@tatianemiranda.com.br"
                    aria-label="Email"
                >
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path
                            d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                        ></path><polyline points="22,6 12,13 2,6"
                        ></polyline></svg
                    >
                </a>
            </div>
        </div>
    </div>

    <div class="footer-bottom">
        <div class="container bottom-content">
            <p>&copy; {year} Tatiane Miranda. Todos os direitos reservados.</p>
            <p class="credits">
                Desenvolvido por <a href="https://www.sitesalphacode.com.br/solucoes/psicologos" target="_blank">Alpha Code</a>
            </p>
        </div>
    </div>
</footer>

<style>
    .footer {
        background-color: var(--color-primary);
        color: white;
        padding: 80px 0 0 0;
        margin-top: 50px;
    }

    .footer-content {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 60px;
        padding-bottom: 60px;
    }

    .footer-logo {
        color: white;
        font-size: 2rem;
        margin-bottom: 10px;
    }

    .footer-crp {
        font-weight: 300;
        font-size: 0.9rem;
        letter-spacing: 1px;
        margin-bottom: 20px;
        opacity: 0.8;
    }

    .footer-bio {
        max-width: 400px;
        font-size: 0.95rem;
        opacity: 0.7;
    }

    .footer h3 {
        font-family: var(--font-display);
        font-size: 1.4rem;
        margin-bottom: 25px;
        color: white;
    }

    .footer-links ul {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .footer-links a {
        color: rgba(255, 255, 255, 0.7);
        transition: color 0.3s ease;
    }

    .footer-links a:hover {
        color: white;
        padding-left: 5px;
    }

    .social-icons {
        display: flex;
        gap: 20px;
    }

    .social-icons a {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

    .social-icons a:hover {
        background: white;
        color: var(--color-primary);
        transform: translateY(-5px);
    }

    .footer-bottom {
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding: 30px 0;
        font-size: 0.85rem;
        opacity: 0.6;
    }

    .bottom-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .credits a {
        text-decoration: underline;
    }

    @media (max-width: 768px) {
        .footer-content {
            grid-template-columns: 1fr;
            gap: 40px;
        }

        .bottom-content {
            flex-direction: column;
            gap: 10px;
            text-align: center;
        }
    }
</style>
