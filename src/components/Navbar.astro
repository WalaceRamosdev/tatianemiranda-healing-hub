---
const navItems = [
    { name: "Home", href: "/" },
    { name: "Sobre mim", href: "/#sobre" },
    { name: "Atendimento", href: "/#atendimento" },
    { name: "Dúvidas", href: "/#duvidas" },
    { name: "Dicas", href: "/dicas" },
    { name: "Feedback", href: "/#feedback" },
    { name: "Contato", href: "/#contato" },
];

const pathname = new URL(Astro.request.url).pathname;
---

<header id="main-header" class="header">
    <div class="container nav-container">
        <a href="/" class="logo">
            <span class="logo-text">Tatiane Miranda</span>
            <span class="logo-subline">Psicóloga Clínica</span>
        </a>

        <button id="menu-toggle" class="menu-toggle" aria-label="Abrir menu">
            <span class="hamburger"></span>
        </button>

        <nav id="nav-menu" class="nav-menu">
            <ul>
                {
                    navItems.map((item) => (
                        <li>
                            <a
                                href={item.href}
                                class={pathname === item.href ? "active" : ""}
                            >
                                {item.name}
                                {pathname === item.href && (
                                    <span
                                        class="indicator"
                                        transition:name="nav-indicator"
                                    />
                                )}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
    </div>
</header>

<style>
    .header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1000;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        padding: 20px 0;
    }

    .header.scrolled {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        padding: 10px 0;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
        border-bottom: 1px solid var(--secondary-light);
    }

    .nav-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .logo {
        display: flex;
        flex-direction: column;
        text-decoration: none;
    }

    .logo-text {
        font-family: var(--font-display);
        font-size: 1.5rem;
        color: var(--primary-soft);
        transition: color 0.3s ease;
    }

    .header.scrolled .logo-text {
        color: var(--primary-soft);
    }

    .logo-subline {
        font-size: 0.7rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--primary-soft);
        opacity: 0.8;
    }

    .header.scrolled .logo-subline {
        color: var(--primary-soft);
    }

    .nav-menu ul {
        display: flex;
        gap: 30px;
    }

    .nav-menu a {
        color: var(--primary-soft);
        font-weight: 500;
        font-size: 0.95rem;
        position: relative;
        padding: 5px 0;
    }

    .header.scrolled .nav-menu a {
        color: var(--primary-soft);
    }

    .nav-menu a:hover {
        color: var(--primary-hover);
    }

    .nav-menu a.active {
        color: var(--primary-soft);
        font-weight: 700;
    }

    .header.scrolled .nav-menu a.active {
        color: var(--primary-hover);
    }

    .indicator {
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 100%;
        height: 2px;
        background-color: var(--primary-soft);
        border-radius: 2px;
    }

    .header.scrolled .indicator {
        background-color: var(--primary-soft);
    }

    .menu-toggle {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        padding: 10px;
    }

    .hamburger {
        display: block;
        width: 25px;
        height: 2.5px;
        background: var(--primary-soft);
        position: relative;
        transition: all 0.3s ease;
    }

    .header.scrolled .hamburger {
        background: var(--primary-soft);
    }

    .hamburger::before,
    .hamburger::after {
        content: "";
        position: absolute;
        width: 100%;
        height: 2.5px;
        background: inherit;
        left: 0;
        transition: all 0.3s ease;
    }

    .hamburger::before {
        top: -8px;
    }
    .hamburger::after {
        bottom: -8px;
    }

    @media (max-width: 992px) {
        .menu-toggle {
            display: block;
        }

        .nav-menu {
            position: fixed;
            top: 0;
            right: -100%;
            width: 70%;
            height: 100vh;
            background: white;
            padding: 100px 40px;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: -10px 0 30px rgba(0, 0, 0, 0.1);
        }

        .nav-menu.active {
            right: 0;
        }

        .nav-menu ul {
            flex-direction: column;
            gap: 20px;
        }

        .nav-menu a {
            font-size: 1.2rem;
            color: var(--primary-soft) !important;
        }
    }
</style>

<script>
    function handleScroll() {
        const header = document.getElementById("main-header");
        if (window.scrollY > 50) {
            header?.classList.add("scrolled");
        } else {
            header?.classList.remove("scrolled");
        }
    }

    function setupMenu() {
        const toggle = document.getElementById("menu-toggle");
        const menu = document.getElementById("nav-menu");

        toggle?.addEventListener("click", () => {
            menu?.classList.toggle("active");
            toggle.classList.toggle("open");
        });

        // Close menu when clicking a link
        const links = document.querySelectorAll(".nav-menu a");
        links.forEach((link) => {
            link.addEventListener("click", () => {
                menu?.classList.remove("active");
                toggle?.classList.remove("open");
            });
        });
    }

    document.addEventListener("astro:page-load", () => {
        handleScroll();
        setupMenu();
        window.addEventListener("scroll", handleScroll);
    });
</script>
