---

---

<section
    id="contato"
    class="section-padding bg-primary relative overflow-hidden"
>
    {/* Particle Canvas */}
    <canvas id="contact-particles" class="absolute inset-0 z-0 opacity-30"
    ></canvas>

    <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-5xl mx-auto">
            <div class="grid lg:grid-cols-2 gap-16 items-center">
                {/* Text Side */}
                <div>
                    <span
                        class="text-white/60 font-body text-sm font-bold uppercase tracking-[0.3em] mb-4 block"
                        >Contato</span
                    >
                    <h2
                        class="font-heading text-4xl md:text-5xl text-white mb-8"
                    >
                        Vamos iniciar sua jornada de <span
                            class="italic font-light">autodescoberta?</span
                        >
                    </h2>
                    <p
                        class="font-body text-lg text-white/80 leading-relaxed mb-8"
                    >
                        Sinta-se à vontade para enviar uma mensagem. Estou aqui
                        para oferecer o acolhimento e escuta que você precisa.
                    </p>

                    <div class="space-y-6">
                        <div class="flex items-center gap-4 text-white/90">
                            <div
                                class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    ><path
                                        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                                    ></path></svg
                                >
                            </div>
                            <span class="font-body">(21) 99906-4502</span>
                        </div>
                        <div class="flex items-center gap-4 text-white/90">
                            <div
                                class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    ><rect
                                        width="20"
                                        height="16"
                                        x="2"
                                        y="4"
                                        rx="2"></rect><path
                                        d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
                                    ></path></svg
                                >
                            </div>
                            <span class="font-body"
                                >contato@tatianemiranda.com.br</span
                            >
                        </div>
                    </div>
                </div>

                {/* Form Side */}
                <div
                    class="bg-white/5 backdrop-blur-xl p-8 md:p-12 rounded-[2.5rem] border border-white/10 shadow-2xl"
                >
                    <form class="space-y-6">
                        <div class="grid md:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label
                                    class="text-white/60 text-xs uppercase tracking-widest font-bold ml-1"
                                    >Nome</label
                                >
                                <input
                                    type="text"
                                    placeholder="Seu nome completo"
                                    class="w-full bg-white/5 border border-white/10 rounded-2xl px-6 py-4 text-white placeholder:text-white/20 focus:outline-none focus:border-white/30 transition-all font-body"
                                />
                            </div>
                            <div class="space-y-2">
                                <label
                                    class="text-white/60 text-xs uppercase tracking-widest font-bold ml-1"
                                    >WhatsApp</label
                                >
                                <input
                                    type="tel"
                                    placeholder="(00) 00000-0000"
                                    class="w-full bg-white/5 border border-white/10 rounded-2xl px-6 py-4 text-white placeholder:text-white/20 focus:outline-none focus:border-white/30 transition-all font-body"
                                />
                            </div>
                        </div>

                        <div class="space-y-2">
                            <label
                                class="text-white/60 text-xs uppercase tracking-widest font-bold ml-1"
                                >Assunto</label
                            >
                            <select
                                id="contact-subject"
                                class="w-full bg-white/5 border border-white/10 rounded-2xl px-6 py-4 text-white/60 focus:outline-none focus:border-white/30 transition-all font-body appearance-none"
                            >
                                <option
                                    class="bg-primary text-white"
                                    value="Primeira Consulta"
                                    >Primeira Consulta</option
                                >
                                <option
                                    class="bg-primary text-white"
                                    value="Ansiedade">Ansiedade</option
                                >
                                <option
                                    class="bg-primary text-white"
                                    value="Autoestima">Autoestima</option
                                >
                                <option
                                    class="bg-primary text-white"
                                    value="Relacionamentos"
                                    >Relacionamentos</option
                                >
                                <option
                                    class="bg-primary text-white"
                                    value="Carreira">Carreira</option
                                >
                                <option
                                    class="bg-primary text-white"
                                    value="Autoconhecimento"
                                    >Autoconhecimento</option
                                >
                                <option
                                    class="bg-primary text-white"
                                    value="Luto e Perdas">Luto e Perdas</option
                                >
                                <option
                                    class="bg-primary text-white"
                                    value="Dúvidas sobre Terapia"
                                    >Dúvidas sobre Terapia</option
                                >
                                <option
                                    class="bg-primary text-white"
                                    value="Parcerias">Parcerias</option
                                >
                            </select>
                        </div>

                        <div class="space-y-2">
                            <label
                                class="text-white/60 text-xs uppercase tracking-widest font-bold ml-1"
                                >Mensagem</label
                            >
                            <textarea
                                id="contact-message"
                                rows="4"
                                placeholder="Como posso te ajudar?"
                                class="w-full bg-white/5 border border-white/10 rounded-2xl px-6 py-4 text-white placeholder:text-white/20 focus:outline-none focus:border-white/30 transition-all font-body resize-none"
                            ></textarea>
                        </div>

                        <button
                            type="submit"
                            class="w-full py-5 rounded-2xl font-body font-bold text-white transition-all duration-300 hover:shadow-[0_0_30px_rgba(255,255,255,0.1)] group relative overflow-hidden"
                            style="border: 2px solid #b8860b; background: transparent;"
                        >
                            <div
                                class="absolute inset-0 bg-white/5 opacity-0 group-hover:opacity-100 transition-opacity"
                            >
                            </div>
                            <span
                                class="relative z-10 uppercase tracking-[0.2em] group-hover:scale-105 transition-transform block"
                                >Enviar Mensagem</span
                            >
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function initContactParticles() {
        const canvas = document.getElementById(
            "contact-particles",
        ) as HTMLCanvasElement;
        if (!canvas) return;

        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        const resize = () => {
            canvas.width = canvas.offsetWidth;
            canvas.height = canvas.offsetHeight;
        };

        window.addEventListener("resize", resize);
        resize();

        const particles: any[] = [];
        const count = 30;

        class Particle {
            x: number;
            y: number;
            s: number;
            vx: number;
            vy: number;
            o: number;
            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.s = Math.random() * 2 + 0.5;
                this.vx = Math.random() * 0.4 - 0.2;
                this.vy = Math.random() * 0.4 - 0.2;
                this.o = Math.random() * 0.5 + 0.2;
            }
            update() {
                this.x += this.vx;
                this.y += this.vy;
                if (this.x > canvas.width) this.x = 0;
                if (this.x < 0) this.x = canvas.width;
                if (this.y > canvas.height) this.y = 0;
                if (this.y < 0) this.y = canvas.height;
            }
            draw() {
                if (!ctx) return;
                ctx.fillStyle = `rgba(255, 255, 255, ${this.o})`;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.s, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        for (let i = 0; i < count; i++) particles.push(new Particle());

        function loop() {
            if (!ctx) return;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach((p) => {
                p.update();
                p.draw();
            });
            requestAnimationFrame(loop);
        }
        loop();
    }
    initContactParticles();

    // Pre-fill subject from URL
    function handleUrlParams() {
        // Handle both search params and hash params
        const fullUrl = window.location.href;
        const urlParts = fullUrl.split("#");
        if (urlParts.length < 2) return;

        const hashPart = urlParts[1];
        const paramPart = hashPart.includes("?") ? hashPart.split("?")[1] : "";
        const urlParams = new URLSearchParams(paramPart);

        const subject = urlParams.get("subject");
        const text = urlParams.get("text");

        const select = document.getElementById(
            "contact-subject",
        ) as HTMLSelectElement;
        const message = document.getElementById(
            "contact-message",
        ) as HTMLTextAreaElement;
        const contactSection = document.getElementById("contato");

        if (subject || text) {
            // Scroll to contact section
            if (contactSection) {
                contactSection.scrollIntoView({ behavior: "smooth" });
            }

            if (subject && select) {
                const options = Array.from(select.options);
                const targetOption = options.find(
                    (opt) =>
                        opt.value.toLowerCase() ===
                        subject.toLowerCase().replace(/%20/g, " "),
                );

                if (targetOption) {
                    select.value = targetOption.value;
                    select.classList.remove("text-white/60");
                    select.classList.add("text-white");
                }
            }

            if (text && message) {
                message.value = decodeURIComponent(text);
                // Also update subject if not provided but implied in text
                if (!subject) {
                    // Optional: logical inference if needed
                }
            }
        }
    }

    // Run on load
    handleUrlParams();

    // Watch for clicks on "Saiba mais" to update form and scroll
    document.addEventListener("click", (e) => {
        const link = (e.target as HTMLElement).closest('a[href*="#contato"]');
        if (link) {
            // Give a tiny delay for the hash to update in some browsers
            setTimeout(handleUrlParams, 50);
        }
    });

    window.addEventListener("popstate", handleUrlParams);
    window.addEventListener("hashchange", handleUrlParams);
</script>
