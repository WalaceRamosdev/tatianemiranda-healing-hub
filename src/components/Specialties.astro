---
const specialties = [
    {
        icon: "brain",
        title: "Ansiedade",
        desc: "Técnicas baseadas em evidências para lidar com o estresse, crises e reencontrar a calma no cotidiano.",
    },
    {
        icon: "heart",
        title: "Autoestima",
        desc: "Um processo profundo de aceitação e valorização para que você se sinta seguro sendo quem você é.",
    },
    {
        icon: "users",
        title: "Relacionamentos",
        desc: "Desenvolva inteligência emocional para construir e manter conexões mais saudáveis e significativas.",
    },
    {
        icon: "briefcase",
        title: "Carreira",
        desc: "Equilíbrio entre vida pessoal e profissional, lidando com burnout, transições e propósito.",
    },
    {
        icon: "sparkles",
        title: "Autoconhecimento",
        desc: "Explore seus valores, crenças e motivações para viver uma vida com mais sentido e autenticidade.",
    },
    {
        icon: "shield",
        title: "Luto e Perdas",
        desc: "Acolhimento humanizado para ressignificar a dor e encontrar novos caminhos diante da ausência.",
    },
];

const icons = {
    brain: '<path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .52 8.105 4 4 0 0 0 5.232 1.25 4 4 0 0 0 5.232-1.25 4 4 0 0 0 .52-8.105 4 4 0 0 0-2.526-5.77A3 3 0 0 0 12 5Z"/><path d="M9 13a4.5 4.5 0 0 0 3-4"/><path d="M15 13a4.5 4.5 0 0 1-3-4"/><path d="M12 13V8"/>',
    heart: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
    users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
    briefcase:
        '<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/>',
    sparkles:
        '<path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M3 5h4"/><path d="M21 17v4"/><path d="M19 19h4"/>',
    shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/>',
};
---

<section id="especialidades" class="section-padding bg-secondary/30 relative">
    <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center mb-20">
            <span
                class="text-primary font-body text-sm font-bold uppercase tracking-[0.3em] mb-4 block"
                >Especialidades</span
            >
            <h2 class="font-heading text-4xl md:text-5xl text-primary mb-6">
                Como posso te ajudar hoje?
            </h2>
            <p class="font-body text-lg text-muted-foreground leading-relaxed">
                Cada pessoa vive uma realidade única. Meu objetivo é oferecer
                suporte especializado para que você possa enfrentar seus
                desafios com mais clareza e autonomia.
            </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
            {
                specialties.map((s, index) => (
                    <div
                        class="bg-white rounded-3xl p-8 border border-primary/5 hover:border-[#b8860b]/30 hover:shadow-premium transition-all duration-500 group"
                        style={`animation: fadeIn 0.8s ease-out forwards; animation-delay: ${index * 0.1}s; opacity: 0;`}
                    >
                        <div class="w-14 h-14 rounded-2xl bg-[var(--primary)]/10 flex items-center justify-center mb-6 group-hover:bg-[#b8860b] group-hover:scale-110 transition-all duration-500">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="text-primary group-hover:text-white transition-colors"
                                set:html={icons[s.icon as keyof typeof icons]}
                            />
                        </div>
                        <h3 class="font-heading text-2xl text-primary mb-4">
                            {s.title}
                        </h3>
                        <p class="font-body text-base text-muted-foreground leading-relaxed">
                            {s.desc}
                        </p>

                        <div class="mt-8 pt-6 border-t border-[var(--primary)]/5 overflow-hidden">
                            <a
                                href={`#contato?subject=${s.title}&text=${encodeURIComponent(`Olá! Gostaria de saber mais sobre o atendimento para ${s.title}. Baseado na descrição: ${s.desc}`)}`}
                                class="text-primary hover:text-primary/80 text-sm font-body font-bold flex items-center gap-2 group/link"
                            >
                                Saiba mais
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="16"
                                    height="16"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="transition-transform group-hover/link:translate-x-1"
                                >
                                    <>
                                        <path d="M5 12h14" />
                                        <path d="m12 5 7 7-7 7" />
                                    </>
                                </svg>
                            </a>
                        </div>
                    </div>
                ))
            }
        </div>

        <div class="mt-20 text-center">
            <p class="font-body text-muted-foreground mb-8 italic">
                Não encontrou o que procurava? Sinta-se à vontade para
                perguntar.
            </p>
            <a
                href="https://wa.me/5521999064502?text=Olá Tatiane! Gostaria de conversar sobre o seu atendimento e tirar algumas dúvidas."
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block px-10 py-5 rounded-full font-body font-bold text-primary transition-all duration-300 hover:shadow-lg border-2"
                style="border-color: #b8860b; background: transparent;"
            >
                <span class="uppercase tracking-[0.2em]"
                    >Conversar via WhatsApp</span
                >
            </a>
        </div>
    </div>
</section>
