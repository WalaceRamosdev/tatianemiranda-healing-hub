---
interface Props {
    title: string;
    subtitle: string;
    ctaText: string;
    ctaLink: string;
}

const { title, subtitle, ctaText, ctaLink } = Astro.props;
---

<section class="hero">
    <div class="container hero-content">
        <div class="hero-text" data-reveal>
            <h1 class="hero-title">{title}</h1>
            <p class="hero-subtitle">{subtitle}</p>
            <div class="hero-actions">
                <a href={ctaLink} class="btn btn-primary">{ctaText}</a>
                <a href="/sobre" class="btn btn-outline">Saiba mais</a>
            </div>
        </div>
        <div class="hero-visual" data-reveal>
            <div class="image-wrapper">
                <div class="image-placeholder">
                    <!-- The user can replace this with an actual image -->
                    <span>Tatiane Miranda</span>
                </div>
                <div class="circle-decoration"></div>
                <div class="square-decoration"></div>
            </div>
        </div>
    </div>
</section>

<style>
    .hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        background: linear-gradient(
            135deg,
            var(--secondary-ice) 0%,
            var(--neutral-white) 100%
        );
        position: relative;
        overflow: hidden;
        padding-top: 100px;
    }

    .hero::before {
        content: "";
        position: absolute;
        top: -10%;
        right: -10%;
        width: 600px;
        height: 600px;
        background: rgba(106, 140, 175, 0.05);
        border-radius: 50%;
        z-index: 0;
    }

    .hero-content {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 60px;
        align-items: center;
        position: relative;
        z-index: 1;
    }

    .hero-title {
        font-size: clamp(3rem, 8vw, 4.5rem);
        margin-bottom: 20px;
        animation: fadeInUp 1s ease;
    }

    .hero-subtitle {
        font-size: 1.2rem;
        color: var(--neutral-gray-600);
        margin-bottom: 40px;
        max-width: 600px;
    }

    .hero-actions {
        display: flex;
        gap: 20px;
    }

    .hero-visual {
        position: relative;
    }

    .image-wrapper {
        position: relative;
        width: 100%;
        max-width: 450px;
        aspect-ratio: 4/5;
        margin: 0 auto;
    }

    .image-placeholder {
        width: 100%;
        height: 100%;
        background-color: var(--secondary-light);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-display);
        font-size: 2rem;
        color: var(--primary-soft);
        box-shadow: var(--shadow-medium);
        z-index: 2;
        position: relative;
    }

    .circle-decoration {
        position: absolute;
        bottom: -20px;
        left: -20px;
        width: 150px;
        height: 150px;
        border: 2px solid var(--color-gold);
        border-radius: 50%;
        z-index: 1;
        opacity: 0.5;
        animation: float 6s ease-in-out infinite;
    }

    .square-decoration {
        position: absolute;
        top: -30px;
        right: -30px;
        width: 120px;
        height: 120px;
        background: linear-gradient(135deg, var(--color-gold) 0%, #e6be75 100%);
        border-radius: 20px;
        z-index: 1;
        opacity: 0.15;
        animation: float 8s ease-in-out infinite reverse;
    }

    .hero::after {
        content: "";
        position: absolute;
        bottom: 10%;
        left: 5%;
        width: 200px;
        height: 200px;
        background: radial-gradient(
            circle,
            rgba(197, 160, 89, 0.1) 0%,
            transparent 70%
        );
        z-index: 0;
        animation: pulseGold 4s ease-in-out infinite;
    }

    @keyframes float {
        0%,
        100% {
            transform: translateY(0) rotate(0);
        }
        50% {
            transform: translateY(-20px) rotate(5deg);
        }
    }

    @keyframes pulseGold {
        0%,
        100% {
            opacity: 0.3;
            transform: scale(1);
        }
        50% {
            opacity: 0.6;
            transform: scale(1.1);
        }
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (max-width: 992px) {
        .hero-content {
            grid-template-columns: 1fr;
            text-align: center;
            padding-bottom: 60px;
        }

        .hero-subtitle {
            margin-left: auto;
            margin-right: auto;
        }

        .hero-actions {
            justify-content: center;
        }

        .hero-visual {
            order: -1;
        }
    }
</style>
