---
interface Props {
    title: string;
    subtitle: string;
    ctaText: string;
    ctaLink: string;
}

const { title, subtitle, ctaText, ctaLink } = Astro.props;
---

<section class="hero">
    <div class="container hero-content">
        <div class="hero-text" data-reveal>
            <h1 class="hero-title">{title}</h1>
            <p class="hero-subtitle">{subtitle}</p>
            <div class="hero-actions">
                <a href={ctaLink} class="btn btn-primary">{ctaText}</a>
                <a href="/sobre" class="btn btn-outline">Saiba mais</a>
            </div>
        </div>
        <div class="hero-visual" data-reveal>
            <div class="image-wrapper">
                <div class="image-placeholder">
                    <!-- The user can replace this with an actual image -->
                    <span>Tatiane Miranda</span>
                </div>
                <div class="circle-decoration"></div>
                <div class="square-decoration"></div>
            </div>
        </div>
    </div>
</section>

<style>
    .hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        background: linear-gradient(135deg, #e1ecef 0%, #f4f9fb 100%);
        position: relative;
        overflow: hidden;
        padding-top: 100px;
    }

    .hero::before {
        content: "";
        position: absolute;
        top: -10%;
        right: -10%;
        width: 600px;
        height: 600px;
        background: rgba(58, 82, 126, 0.03);
        border-radius: 50%;
        z-index: 0;
    }

    .hero-content {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 60px;
        align-items: center;
        position: relative;
        z-index: 1;
    }

    .hero-title {
        font-size: clamp(3rem, 8vw, 4.5rem);
        margin-bottom: 20px;
        animation: fadeInUp 1s ease;
    }

    .hero-subtitle {
        font-size: 1.2rem;
        color: #555;
        margin-bottom: 40px;
        max-width: 600px;
    }

    .hero-actions {
        display: flex;
        gap: 20px;
    }

    .hero-visual {
        position: relative;
    }

    .image-wrapper {
        position: relative;
        width: 100%;
        max-width: 450px;
        aspect-ratio: 4/5;
        margin: 0 auto;
    }

    .image-placeholder {
        width: 100%;
        height: 100%;
        background-color: #d1dde2;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-display);
        font-size: 2rem;
        color: var(--color-primary);
        box-shadow: var(--shadow-medium);
        z-index: 2;
        position: relative;
    }

    .circle-decoration {
        position: absolute;
        bottom: -20px;
        left: -20px;
        width: 150px;
        height: 150px;
        border: 3px solid var(--color-primary);
        border-radius: 50%;
        z-index: 1;
        opacity: 0.3;
    }

    .square-decoration {
        position: absolute;
        top: -20px;
        right: -20px;
        width: 100px;
        height: 100px;
        background: var(--color-primary);
        border-radius: 10px;
        z-index: 1;
        opacity: 0.1;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (max-width: 992px) {
        .hero-content {
            grid-template-columns: 1fr;
            text-align: center;
            padding-bottom: 60px;
        }

        .hero-subtitle {
            margin-left: auto;
            margin-right: auto;
        }

        .hero-actions {
            justify-content: center;
        }

        .hero-visual {
            order: -1;
        }
    }
</style>
