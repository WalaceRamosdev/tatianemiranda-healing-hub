---
import { Image } from "astro:assets";
import consultorioImg from "../assets/consultorio.png";
---

<section
    id="inicio"
    class="relative min-h-screen flex items-center justify-center overflow-hidden bg-primary"
>
    {/* Desktop Background (Photo) */}
    <div class="absolute inset-0 z-0 hidden md:block">
        <Image
            src={consultorioImg}
            alt="Consultório acolhedor da Psicóloga Tatiane Miranda com iluminação suave e poltronas confortáveis para atendimento."
            class="w-full h-full object-cover object-[center_25%]"
            quality="high"
        />
        <div
            class="absolute inset-0 bg-gradient-to-br from-primary/95 via-primary/80 to-primary/60 mix-blend-multiply"
        >
        </div>
    </div>

    {/* Mobile Background (Particles) */}
    <div class="absolute inset-0 z-0 md:hidden bg-primary overflow-hidden">
        <canvas id="particle-canvas" class="absolute inset-0 opacity-40"
        ></canvas>
        <div
            class="absolute inset-0 bg-gradient-to-b from-primary/20 via-primary/60 to-primary"
        >
        </div>
    </div>

    <div
        class="relative z-10 container mx-auto px-4 text-center pt-32 md:pt-20 pb-20"
    >
        <div
            class="animate-fade-in opacity-0 flex flex-col items-center"
            style="animation-delay: 0.2s; animation-fill-mode: forwards;"
        >
            <span
                class="inline-block px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md text-white/90 text-xs md:text-sm font-body tracking-widest uppercase mb-8 border border-white/20"
            >
                Acolhimento & Bem-estar
            </span>

            <h1
                class="font-heading text-5xl md:text-7xl lg:text-8xl text-white mb-8 leading-[1.1]"
            >
                Psicologia que
                <br />
                <span class="text-[#b8860b] italic font-light"
                    >Transforma Vidas</span
                >
            </h1>

            <p
                class="font-body text-lg md:text-2xl text-white/90 max-w-3xl mx-auto mb-12 leading-relaxed"
            >
                Um espaço seguro e acolhedor para você se reconectar consigo
                mesmo e encontrar o equilíbrio emocional que deseja.
            </p>

            <div
                class="flex flex-col sm:flex-row items-center justify-center gap-6"
            >
                <a
                    href="#contato"
                    class="group relative inline-flex items-center justify-center px-10 py-5 rounded-full text-lg font-body font-bold text-white transition-all duration-300 overflow-hidden shadow-lg hover:shadow-[0_0_30px_rgba(184,134,11,0.2)] border-2"
                    style="border-color: #b8860b; background: transparent;"
                >
                    <div
                        class="absolute inset-0 z-0 bg-white/5 opacity-0 group-hover:opacity-100 transition-opacity"
                    >
                    </div>
                    <span
                        class="relative z-10 uppercase tracking-[0.2em] group-hover:scale-105 transition-transform"
                        >AGENDAR CONSULTA</span
                    >
                </a>

                <a
                    href="#sobre"
                    class="text-white/80 hover:text-white font-body font-medium transition-colors flex items-center gap-2 group"
                >
                    Conheça meu trabalho
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="transition-transform group-hover:translate-x-1"
                        ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"
                        ></path></svg
                    >
                </a>
            </div>
        </div>
    </div>

    {/* Decorative elements */}
    <div
        class="absolute bottom-10 left-1/2 -translate-x-1/2 z-10 animate-bounce text-white/40"
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M7 13l5 5 5-5M7 6l5 5 5-5"></path></svg
        >
    </div>

    {/* Bottom curve */}
    <div class="absolute bottom-0 left-0 right-0 z-0">
        <svg
            viewBox="0 0 1440 120"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            class="w-full h-auto"
        >
            <path
                d="M0 120V60C240 20 480 0 720 0C960 0 1200 20 1440 60V120H0Z"
                fill="hsl(var(--background))"></path>
        </svg>
    </div>
</section>

<script>
    function initParticles() {
        const canvas = document.getElementById(
            "particle-canvas",
        ) as HTMLCanvasElement;
        if (!canvas || window.innerWidth >= 768) return;

        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;

        const particles: any[] = [];
        const particleCount = 40;

        class Particle {
            x: number;
            y: number;
            size: number;
            speedX: number;
            speedY: number;
            opacity: number;

            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.size = Math.random() * 3 + 1;
                this.speedX = Math.random() * 0.5 - 0.25;
                this.speedY = Math.random() * 0.5 - 0.25;
                this.opacity = Math.random() * 0.5 + 0.2;
            }

            update() {
                this.x += this.speedX;
                this.y += this.speedY;

                if (this.x > canvas.width) this.x = 0;
                if (this.x < 0) this.x = canvas.width;
                if (this.y > canvas.height) this.y = 0;
                if (this.y < 0) this.y = canvas.height;
            }

            draw() {
                if (!ctx) return;
                ctx.fillStyle = `rgba(255, 255, 255, ${this.opacity})`;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        for (let i = 0; i < particleCount; i++) {
            particles.push(new Particle());
        }

        function animate() {
            if (!ctx) return;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach((p) => {
                p.update();
                p.draw();
            });
            requestAnimationFrame(animate);
        }

        animate();
    }

    // Run on load and on resize
    initParticles();
    window.addEventListener("resize", initParticles);
</script>
