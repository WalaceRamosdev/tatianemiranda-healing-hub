---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contato">
    <section class="contact-hero section-light">
        <div class="container" data-reveal>
            <h1 class="font-display">Contato</h1>
            <p class="subtitle">Agende sua consulta ou tire suas dúvidas.</p>
        </div>
    </section>

    <section class="contact-section section-ice">
        <div class="container contact-grid">
            <div class="contact-info" data-reveal>
                <div class="info-item">
                    <div class="icon">
                        <svg
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><path
                                d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                            ></path><polyline points="22,6 12,13 2,6"
                            ></polyline></svg
                        >
                    </div>
                    <div>
                        <h3>Email</h3>
                        <p>contato@tatianemiranda.com.br</p>
                    </div>
                </div>
                <div class="info-item">
                    <div class="icon">
                        <svg
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><path
                                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.81 12.81 0 0 0 .63 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7z"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <h3>Telefone / WhatsApp</h3>
                        <p>(11) 99999-9999</p>
                    </div>
                </div>
                <div class="info-item">
                    <div class="icon">
                        <svg
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><path
                                d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                            ></path><circle cx="12" cy="10" r="3"></circle></svg
                        >
                    </div>
                    <div>
                        <h3>Consultório</h3>
                        <p>
                            Rua Exemplo, 123 - Sala 45<br />Bairro - Cidade/UF
                        </p>
                    </div>
                </div>
            </div>

            <div class="contact-form-container" data-reveal>
                <form id="contact-form" class="contact-form">
                    <div class="form-group">
                        <label for="name">Nome Completo</label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            required
                            placeholder="Seu nome"
                        />
                        <span class="error-msg"
                            >Por favor, seu nome é obrigatório.</span
                        >
                    </div>

                    <div class="form-group">
                        <label for="email">E-mail</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            placeholder="seu@email.com"
                        />
                        <span class="error-msg">E-mail inválido.</span>
                    </div>

                    <div class="form-group">
                        <label for="message">Mensagem</label>
                        <textarea
                            id="message"
                            name="message"
                            required
                            placeholder="Como posso te ajudar?"
                            maxlength="500"></textarea>
                        <div class="char-count">
                            <span id="count">0</span>/500
                        </div>
                    </div>

                    <button
                        type="submit"
                        class="btn btn-primary"
                        id="submit-btn"
                    >
                        Enviar Mensagem
                        <span class="loader" id="loader"></span>
                    </button>

                    <div id="form-feedback" class="form-feedback"></div>
                </form>
            </div>
        </div>
    </section>
</Layout>

<style>
    .contact-hero {
        padding-top: 150px;
        text-align: center;
    }

    .subtitle {
        color: var(--neutral-gray-600);
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1.5fr;
        gap: 80px;
        margin: 60px auto 100px;
    }

    .info-item {
        display: flex;
        gap: 20px;
        margin-bottom: 40px;
    }

    .info-item .icon {
        width: 50px;
        height: 50px;
        background: var(--secondary-light);
        color: var(--primary-soft);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .info-item h3 {
        font-size: 1.1rem;
        margin-bottom: 5px;
    }

    .info-item p {
        color: var(--neutral-gray-600);
        line-height: 1.4;
    }

    .contact-form {
        background: white;
        padding: 50px;
        border-radius: 30px;
        box-shadow: var(--shadow-medium);
        border: 1px solid var(--secondary-light);
    }

    .form-group {
        margin-bottom: 25px;
        position: relative;
    }

    label {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
        color: var(--neutral-gray-800);
        font-size: 0.95rem;
    }

    input,
    textarea {
        width: 100%;
        padding: 15px;
        border: 1px solid var(--secondary-light);
        background: var(--neutral-light);
        border-radius: 10px;
        font-family: var(--font-body);
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    input:focus,
    textarea:focus {
        outline: none;
        background: white;
        border-color: var(--primary-soft);
        box-shadow: 0 0 0 4px rgba(106, 140, 175, 0.1);
    }

    textarea {
        height: 150px;
        resize: none;
    }

    .error-msg {
        display: none;
        color: #e74c3c;
        font-size: 0.8rem;
        margin-top: 5px;
    }

    .char-count {
        text-align: right;
        font-size: 0.8rem;
        color: #888;
        margin-top: 5px;
    }

    #submit-btn {
        width: 100%;
        padding: 18px;
        font-size: 1.1rem;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
    }

    .form-feedback {
        margin-top: 20px;
        text-align: center;
        font-weight: 600;
        padding: 15px;
        border-radius: 10px;
        display: none;
    }

    .form-feedback.success {
        display: block;
        background: #d4edda;
        color: #155724;
    }

    .form-feedback.error {
        display: block;
        background: #f8d7da;
        color: #721c24;
    }

    .loader {
        width: 20px;
        height: 20px;
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        border-top-color: white;
        animation: spin 1s linear infinite;
        display: none;
    }

    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @media (max-width: 992px) {
        .contact-grid {
            grid-template-columns: 1fr;
            gap: 50px;
        }

        .contact-form {
            padding: 30px;
        }
    }
</style>

<script>
    function setupForm() {
        const form = document.getElementById("contact-form") as HTMLFormElement;
        const message = document.getElementById(
            "message",
        ) as HTMLTextAreaElement;
        const count = document.getElementById("count");
        const feedback = document.getElementById("form-feedback");
        const submitBtn = document.getElementById(
            "submit-btn",
        ) as HTMLButtonElement;
        const loader = document.getElementById("loader");

        if (message && count) {
            message.addEventListener("input", () => {
                count.textContent = message.value.length.toString();
            });
        }

        form?.addEventListener("submit", async (e) => {
            e.preventDefault();

            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            // Show loader
            if (loader) loader.style.display = "block";
            if (submitBtn) submitBtn.disabled = true;

            // Simulate API call (e.g., Formspree/EmailJS)
            try {
                await new Promise((resolve) => setTimeout(resolve, 2000));

                if (feedback) {
                    feedback.textContent =
                        "Mensagem enviada com sucesso! Em breve entrarei em contato.";
                    feedback.className = "form-feedback success";
                    form.reset();
                    if (count) count.textContent = "0";
                }
            } catch (err) {
                if (feedback) {
                    feedback.textContent =
                        "Ocorreu um erro ao enviar. Tente novamente mais tarde.";
                    feedback.className = "form-feedback error";
                }
            } finally {
                if (loader) loader.style.display = "none";
                if (submitBtn) submitBtn.disabled = false;

                // Hide feedback after 5 seconds
                setTimeout(() => {
                    if (feedback) feedback.style.display = "none";
                }, 5000);
            }
        });
    }

    document.addEventListener("astro:page-load", setupForm);
</script>
