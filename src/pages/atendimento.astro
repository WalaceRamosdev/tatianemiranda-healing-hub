---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Atendimento">
    <section class="atendimento-hero section-light">
        <div class="container" data-reveal>
            <h1 class="font-display">Atendimento</h1>
            <p class="subtitle">
                Encontre o formato que melhor se adapta à sua rotina.
            </p>
        </div>
    </section>

    <section class="modalidades section-ice">
        <div class="container modalidades-grid">
            <div class="modalidade-card" data-reveal>
                <div class="icon">
                    <svg
                        width="60"
                        height="60"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path
                            d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                        ></path><polyline points="9 22 9 12 15 12 15 22"
                        ></polyline></svg
                    >
                </div>
                <h2>Presencial</h2>
                <p>
                    Realizado em um consultório preparado para oferecer o máximo
                    de conforto e privacidade. Ideal para quem prefere o contato
                    humano direto e um ambiente neutro fora da rotina diária.
                </p>
                <ul class="benefits">
                    <li>Ambiente acolhedor e seguro</li>
                    <li>Privacidade absoluta</li>
                    <li>Localização de fácil acesso</li>
                </ul>
                <a href="/contato" class="btn btn-primary">Agendar Presencial</a
                >
            </div>

            <div class="modalidade-card darker" data-reveal>
                <div class="icon">
                    <svg
                        width="60"
                        height="60"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><rect x="2" y="3" width="20" height="14" rx="2" ry="2"
                        ></rect><line x1="8" y1="21" x2="16" y2="21"
                        ></line><line x1="12" y1="17" x2="12" y2="21"
                        ></line></svg
                    >
                </div>
                <h2>Online</h2>
                <p>
                    A terapia online oferece a mesma eficácia, ética e sigilo do
                    atendimento presencial, com a praticidade de realizar as
                    sessões de onde você estiver, via videochamada.
                </p>
                <ul class="benefits">
                    <li>Mesma qualidade e ética</li>
                    <li>Flexibilidade de horários</li>
                    <li>Economia de tempo e deslocamento</li>
                </ul>
                <a href="/contato" class="btn btn-outline">Agendar Online</a>
            </div>
        </div>
    </section>

    <section class="requisitos section-light">
        <div class="container" data-reveal>
            <div class="requisitos-box">
                <h3>Público Alvo</h3>
                <p>
                    Atendimento especializado para <strong>Adolescentes</strong> (a
                    partir de 12 anos) e <strong>Adultos</strong>.
                </p>
            </div>
        </div>
    </section>
</Layout>

<style>
    .atendimento-hero {
        padding-top: 150px;
        text-align: center;
        background: linear-gradient(
            180deg,
            var(--secondary-ice) 0%,
            var(--neutral-white) 100%
        );
    }

    .atendimento-hero h1 {
        font-size: 3.5rem;
        margin-bottom: 15px;
    }

    .subtitle {
        font-size: 1.2rem;
        color: var(--neutral-gray-600);
        max-width: 600px;
        margin: 0 auto;
    }

    .modalidades-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
    }

    .modalidade-card {
        background: white;
        padding: 60px 40px;
        border-radius: 30px;
        box-shadow: var(--shadow-soft);
        border: 1px solid var(--secondary-light);
        text-align: center;
        transition: var(--transition-smooth);
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .modalidade-card:hover {
        transform: translateY(-10px);
        box-shadow: var(--shadow-medium);
    }

    .modalidade-card.darker {
        background: white;
        border: 1px solid var(--primary-soft);
    }

    .icon {
        color: var(--primary-soft);
        margin-bottom: 30px;
    }

    .modalidade-card h2 {
        font-size: 2.2rem;
        margin-bottom: 20px;
    }

    .modalidade-card p {
        color: var(--neutral-gray-600);
        margin-bottom: 30px;
        font-size: 1.05rem;
    }

    .benefits {
        text-align: left;
        margin-bottom: 40px;
        width: 100%;
        max-width: 300px;
    }

    .benefits li {
        margin-bottom: 12px;
        font-size: 0.95rem;
        color: var(--neutral-gray-600);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .benefits li::before {
        content: "";
        width: 6px;
        height: 6px;
        background: var(--primary-soft);
        border-radius: 50%;
    }

    .requisitos {
        padding-bottom: 100px;
    }

    .requisitos-box {
        background: var(--primary-soft);
        color: white;
        padding: 40px;
        border-radius: 20px;
        text-align: center;
    }

    .requisitos-box h3 {
        color: white;
        margin-bottom: 15px;
        font-size: 1.8rem;
    }

    @media (max-width: 992px) {
        .modalidades-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
