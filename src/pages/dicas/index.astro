---
import Layout from "../../layouts/Layout.astro";

const posts = [
    {
        title: "Ansiedade: Como a TCC pode ajudar?",
        summary:
            "Entenda como a abordagem cognitivo-comportamental identifica e trata padrões de pensamento ansiosos.",
        date: "20 Fev 2026",
        image: "Ansiedade",
    },
    {
        title: "O papel do descanso na saúde mental",
        summary:
            "Por que pausar é tão fundamental quanto agir para manter o equilíbrio emocional.",
        date: "15 Fev 2026",
        image: "Descanso",
    },
    {
        title: "Lidando com emoções difíceis",
        summary:
            "Estratégias para acolher o que sentimos sem sermos dominados pela intensidade emocional.",
        date: "10 Fev 2026",
        image: "Emoções",
    },
];
---

<Layout title="Dicas">
    <section class="blog-hero section-light">
        <div class="container" data-reveal>
            <h1 class="font-display">Dicas e Reflexões</h1>
            <p class="subtitle">
                Artigos sobre psicologia, saúde mental e bem-estar.
            </p>
        </div>
    </section>

    <section class="posts section-ice">
        <div class="container blog-grid">
            {
                posts.map((post, index) => (
                    <article
                        class="post-card"
                        data-reveal
                        style={`transition-delay: ${index * 0.1}s`}
                    >
                        <div class="post-image">
                            <span>{post.image}</span>
                        </div>
                        <div class="post-content">
                            <span class="post-date">{post.date}</span>
                            <h2>{post.title}</h2>
                            <p>{post.summary}</p>
                            <a href="#" class="read-more">
                                Ler artigo completo →
                            </a>
                        </div>
                    </article>
                ))
            }
        </div>
    </section>
</Layout>

<style>
    .blog-hero {
        padding-top: 150px;
        text-align: center;
    }

    .subtitle {
        margin-top: 10px;
        color: var(--neutral-gray-600);
    }

    .blog-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
        margin: 60px auto;
    }

    .post-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: var(--shadow-soft);
        transition: var(--transition-smooth);
        border: 1px solid var(--secondary-light);
    }

    .post-card:hover {
        transform: translateY(-10px);
        box-shadow: var(--shadow-medium);
    }

    .post-image {
        width: 100%;
        height: 200px;
        background: var(--secondary-light);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--primary-soft);
        font-family: var(--font-display);
        font-size: 1.5rem;
    }

    .post-content {
        padding: 30px;
    }

    .post-date {
        font-size: 0.85rem;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 10px;
        display: block;
    }

    .post-content h2 {
        font-size: 1.4rem;
        margin-bottom: 15px;
        line-height: 1.3;
    }

    .post-content p {
        color: var(--neutral-gray-600);
        font-size: 0.95rem;
        margin-bottom: 25px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .read-more {
        color: var(--primary-soft);
        font-weight: 700;
        text-decoration: none;
        font-size: 0.95rem;
    }

    .read-more:hover {
        text-decoration: underline;
    }

    @media (max-width: 992px) {
        .blog-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @media (max-width: 768px) {
        .blog-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
