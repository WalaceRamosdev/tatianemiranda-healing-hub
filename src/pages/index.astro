---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/Navbar";
import { Hero } from "../components/Hero";
import { About } from "../components/About";
import { Services } from "../components/Services";
import { Testimonials } from "../components/Testimonials";
import { Location } from "../components/Location";
import { Contact } from "../components/Contact";
import { WhatsAppButton } from "../components/WhatsAppButton";
---

<Layout title="Tatiane Miranda - Psicóloga">
    <div class="relative min-h-screen">
        <Navbar client:load />

        <main>
            <Hero client:load />

            <About client:visible />

            <Services client:visible />

            <Testimonials client:visible />

            <Location client:visible />

            <Contact client:load />
        </main>

        <footer class="py-12 bg-primary text-white/60">
            <div
                class="container mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-8"
            >
                <div class="text-center md:text-left">
                    <h3 class="text-white font-serif text-2xl mb-2">
                        Tatiane Miranda
                    </h3>
                    <p class="text-sm font-light">
                        Psicóloga Clínica • CRP-10/11768
                    </p>
                </div>

                <div class="flex space-x-8 text-sm font-light">
                    <a href="#home" class="hover:text-white transition-colors"
                        >Início</a
                    >
                    <a href="#about" class="hover:text-white transition-colors"
                        >Sobre</a
                    >
                    <a
                        href="#services"
                        class="hover:text-white transition-colors">Serviços</a
                    >
                    <a
                        href="#contact"
                        class="hover:text-white transition-colors">Contato</a
                    >
                </div>

                <div class="text-center md:text-right text-xs font-light">
                    <p>© 2024 Tatiane Miranda. Todos os direitos reservados.</p>
                    <p class="mt-1">Desenvolvido com cuidado.</p>
                </div>
            </div>
        </footer>

        <WhatsAppButton client:load />
    </div>
</Layout>
