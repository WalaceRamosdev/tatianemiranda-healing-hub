---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";

const faqs = [
    {
        q: "Como funciona a primeira sessão?",
        a: "A primeira sessão é um momento de acolhimento e escuta. É nela que nos conhecemos, você compartilha suas principais demandas e dúvidas, e eu explico como o processo terapêutico funciona na prática.",
    },
    {
        q: "Qual a duração da sessão?",
        a: "As sessões têm duração média de 50 minutos, ocorrendo geralmente uma vez por semana, conforme a necessidade de cada caso.",
    },
    {
        q: "A psicóloga atende convênios?",
        a: "Trabalho exclusivamente com atendimentos particulares. No entanto, emito recibos para que você possa solicitar o reembolso junto ao seu plano de saúde.",
    },
];

const feedbacks = [
    {
        name: "Ana P.",
        text: "O processo com a Tatiane mudou minha forma de encarar os desafios do dia a dia. Sinto-me muito mais segura e confiante nas minhas decisões.",
        type: "Adulto",
    },
    {
        name: "Carlos M.",
        text: "Excelente profissional. O ambiente é muito acolhedor e ela passa uma tranquilidade imensa durante as sessões.",
        type: "Presencial",
    },
];
---

<Layout title="Início - Tatiane Miranda Psicóloga">
    <Hero
        title="Transforme sua jornada emocional"
        subtitle="Espaço de acolhimento e desenvolvimento pessoal com base na Terapia Cognitivo-Comportamental para adolescentes e adultos."
        ctaText="Agende sua consulta"
        ctaLink="#contato"
    />

    <!-- SEÇÃO SOBRE -->
    <section id="sobre" class="about-section section-light">
        <div class="bg-circle circle-1"></div>
        <div class="container about-grid">
            <div class="about-image" data-reveal>
                <div class="image-box gold-border">
                    <span>Tatiane Miranda</span>
                </div>
            </div>
            <div class="about-text" data-reveal>
                <span class="section-tag">Sobre Mim</span>
                <h2 class="font-display">Tatiane Miranda</h2>
                <p class="crp">Psicóloga Clínica | CRP-10/11768</p>
                <blockquote class="quote">
                    "Escolhi a Psicologia porque acredito na capacidade de
                    transformação que cada pessoa carrega dentro de si."
                </blockquote>
                <p>
                    Pós-graduada em Terapia Cognitivo-Comportamental (TCC) e
                    pós-graduanda em Avaliação Psicológica e Psicopatologia.
                    Ofereço um espaço seguro, acolhedor e livre de julgamentos
                    para adolescentes e adultos focada no fortalecimento da
                    autonomia e autoconfiança.
                </p>
                <div class="about-actions">
                    <a href="/sobre" class="btn btn-outline"
                        >Ler Biografia Completa</a
                    >
                </div>
            </div>
        </div>
    </section>

    <!-- SEÇÃO ABORDAGEM -->
    <section id="abordagem" class="approach section-ice">
        <div class="bg-circle circle-2"></div>
        <div class="container">
            <div class="section-header" data-reveal>
                <span class="section-tag">Minha Abordagem</span>
                <h2 class="section-title">Encontre Equilíbrio com a TCC</h2>
                <p class="section-subtitle">
                    A Terapia Cognitivo-Comportamental é uma abordagem
                    científica que conecta seus pensamentos às suas emoções e
                    comportamentos.
                </p>
            </div>

            <div class="grid-3">
                <div class="card" data-reveal>
                    <div class="card-icon">
                        <svg
                            width="32"
                            height="32"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"
                            ></path><polyline points="22 4 12 14.01 9 11.01"
                            ></polyline></svg
                        >
                    </div>
                    <h3>Identificar Padrões</h3>
                    <p>
                        Mapear pensamentos que geram sofrimento e limitam sua
                        qualidade de vida.
                    </p>
                </div>
                <div class="card" data-reveal>
                    <div class="card-icon">
                        <svg
                            width="32"
                            height="32"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path
                                d="M2 17l10 5 10-5"></path><path
                                d="M2 12l10 5 10-5"></path></svg
                        >
                    </div>
                    <h3>Novas Perspectivas</h3>
                    <p>
                        Desenvolver formas saudáveis de processar emoções e
                        situações difíceis.
                    </p>
                </div>
                <div class="card" data-reveal>
                    <div class="card-icon">
                        <svg
                            width="32"
                            height="32"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><path
                                d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
                            ></path></svg
                        >
                    </div>
                    <h3>Autoconfiança</h3>
                    <p>
                        Fortalecer sua autonomia emocional para enfrentar os
                        desafios do dia a dia.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- SEÇÃO ATENDIMENTO -->
    <section id="atendimento" class="modalidades section-light">
        <div class="bg-circle circle-3"></div>
        <div class="container">
            <div class="section-header" data-reveal>
                <span class="section-tag">Atendimentos</span>
                <h2 class="section-title">Como podemos trabalhar?</h2>
            </div>
            <div class="modalidades-grid">
                <div class="modalidade-card glass" data-reveal>
                    <div class="m-icon">
                        <svg
                            width="40"
                            height="40"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            ><path
                                d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                            ></path></svg
                        >
                    </div>
                    <h3>Presencial</h3>
                    <p>
                        Ambiente acolhedor e privativo para quem valoriza o
                        encontro físico.
                    </p>
                </div>
                <div class="modalidade-card glass" data-reveal>
                    <div class="m-icon">
                        <svg
                            width="40"
                            height="40"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            ><rect x="2" y="3" width="20" height="14" rx="2"
                            ></rect><path d="M8 21h8M12 17v4"></path></svg
                        >
                    </div>
                    <h3>Online</h3>
                    <p>
                        Mesma ética e sigilo com a liberdade de ser atendido
                        onde você estiver.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- SEÇÃO FEEDBACK -->
    <section id="feedback" class="feedback-section section-ice">
        <div class="bg-circle circle-1"></div>
        <div class="container">
            <div class="section-header" data-reveal>
                <span class="section-tag">Depoimentos</span>
                <h2 class="section-title">O que dizem os pacientes</h2>
            </div>
            <div class="feedback-grid-home">
                {
                    feedbacks.map((f) => (
                        <div class="f-card" data-reveal>
                            <p>"{f.text}"</p>
                            <span class="f-author">
                                {f.name} • {f.type}
                            </span>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- SEÇÃO FAQ -->
    <section id="duvidas" class="faq-home section-light">
        <div class="bg-circle circle-2"></div>
        <div class="container">
            <div class="section-header" data-reveal>
                <h2 class="section-title">Dúvidas Frequentes</h2>
            </div>
            <div class="faq-list">
                {
                    faqs.map((faq) => (
                        <details class="faq-item-home" data-reveal>
                            <summary>
                                {faq.q} <span class="gold-plus">+</span>
                            </summary>
                            <div class="faq-ans">
                                <p>{faq.a}</p>
                            </div>
                        </details>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- SEÇÃO CONTATO INTEGRADA -->
    <section id="contato" class="contact-home section-ice">
        <div class="container contact-box-home">
            <div class="contact-header-home" data-reveal>
                <h2 class="font-display">Vamos Conversar?</h2>
                <p>
                    Preencha os campos abaixo e eu retornarei o contato o mais
                    breve possível.
                </p>
            </div>

            <form id="home-contact-form" class="h-form" data-reveal>
                <div class="form-row">
                    <div class="input-group">
                        <label>Nome</label>
                        <input
                            type="text"
                            placeholder="Seu nome completo"
                            required
                        />
                    </div>
                    <div class="input-group">
                        <label>E-mail</label>
                        <input
                            type="email"
                            placeholder="seu@email.com"
                            required
                        />
                    </div>
                </div>
                <div class="input-group">
                    <label>Assunto</label>
                    <select required>
                        <option value="">Selecione uma opção</option>
                        <option value="consulta">Agendar Consulta</option>
                        <option value="duvida">Dúvida sobre Terapia</option>
                        <option value="outro">Outro assunto</option>
                    </select>
                </div>
                <div class="input-group">
                    <label>Mensagem</label>
                    <textarea
                        placeholder="Como posso te ajudar?"
                        required
                        maxlength="2500"></textarea>
                    <div class="counter">
                        <span id="char-count">0</span>/2500
                    </div>
                </div>
                <button type="submit" class="btn btn-primary gold-glow"
                    >Enviar Solicitação</button
                >
                <div id="form-status" class="status-msg"></div>
            </form>
        </div>
    </section>
</Layout>

<style>
    .bg-soft {
        background-color: var(--secondary-ice);
    }

    .section-tag {
        display: inline-block;
        color: var(--color-gold);
        text-transform: uppercase;
        letter-spacing: 4px;
        font-weight: 900;
        font-size: 0.8rem;
        margin-bottom: 25px;
        padding: 5px 15px;
        border: 1px solid var(--color-gold);
        border-radius: 5px;
        background: rgba(197, 160, 89, 0.05);
    }

    section {
        position: relative;
        overflow: hidden;
    }

    /* Elementos Decorativos de Fundo Intensificados */
    .bg-circle {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        z-index: -1;
        opacity: 0.35; /* Aumentado de 0.15 para 0.35 */
        pointer-events: none;
    }

    .circle-1 {
        top: -10%;
        right: -10%;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, var(--color-gold) 0%, transparent 70%);
        animation: drift 12s infinite alternate ease-in-out;
    }

    .circle-2 {
        bottom: -15%;
        left: -10%;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, var(--color-primary) 0%, transparent 70%);
        animation: drift 15s infinite alternate-reverse ease-in-out;
    }

    .circle-3 {
        top: 40%;
        left: 50%;
        transform: translateX(-50%);
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, var(--color-gold) 0%, transparent 60%);
        opacity: 0.2;
        animation: pulseGold 5s infinite;
    }

    @keyframes drift {
        from { transform: translate(0, 0) scale(1) rotate(0); }
        to { transform: translate(80px, 40px) scale(1.2) rotate(10deg); }
    }

    @keyframes pulseGold {
        0%, 100% { opacity: 0.1; transform: translateX(-50%) scale(1); }
        50% { opacity: 0.3; transform: translateX(-50%) scale(1.2); }
    }
    }

    .section-header {
        text-align: center;
        margin-bottom: 60px;
    }
    .section-title {
        font-size: clamp(2.5rem, 5vw, 3rem);
        margin-bottom: 15px;
    }
    .section-subtitle {
        max-width: 700px;
        margin: 0 auto;
        color: #555;
    }

    /* SOBRE MIM */
    .about-section {
        padding: 120px 0;
    }
    .about-grid {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 80px;
        align-items: center;
    }
    .image-box {
        width: 100%;
        aspect-ratio: 1;
        background: var(--secondary-light);
        border-radius: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-display);
        font-size: 2rem;
        color: var(--primary-soft);
        box-shadow: var(--shadow-medium);
    }
    .gold-border {
        border: 2px solid var(--color-gold);
        outline: 15px solid rgba(197, 160, 89, 0.05);
    }
    .crp {
        color: var(--color-gold);
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 20px;
    }
    .quote {
        font-family: var(--font-display);
        font-size: 1.6rem;
        color: var(--primary-soft);
        font-style: italic;
        margin-bottom: 30px;
        border-left: 3px solid var(--color-gold);
        padding-left: 20px;
        line-height: 1.4;
    }
    .about-text p {
        margin-bottom: 30px;
        line-height: 1.8;
        color: #444;
    }

    /* CARDS ABORDAGEM */
    .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
    }
    .card {
        background: white;
        padding: 40px;
        border-radius: 24px;
        box-shadow: var(--shadow-soft);
        border: 1px solid var(--secondary-light);
        transition: 0.3s;
    }
    .card:hover {
        transform: translateY(-10px);
        box-shadow: var(--shadow-medium);
        border-color: var(--color-gold);
    }
    .card-icon {
        color: var(--color-gold);
        margin-bottom: 20px;
    }
    .card h3 {
        font-size: 1.4rem;
        margin-bottom: 15px;
    }

    /* MODALIDADES */
    .modalidades-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
    }
    .modalidade-card {
        padding: 50px;
        border-radius: 30px;
        text-align: center;
        background: white;
        border: 1px solid rgba(58, 82, 126, 0.08);
    }
    .m-icon {
        color: var(--color-primary);
        margin-bottom: 20px;
    }

    /* FEEDBACK */
    .feedback-grid-home {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
    }
    .f-card {
        background: white;
        padding: 30px;
        border-radius: 20px;
        box-shadow: var(--shadow-soft);
        border: 1px solid var(--secondary-light);
        font-style: italic;
    }
    .f-author {
        display: block;
        margin-top: 15px;
        font-weight: 700;
        font-style: normal;
        color: var(--color-gold);
        font-size: 0.9rem;
    }

    /* FAQ */
    .faq-list {
        max-width: 800px;
        margin: 0 auto;
    }
    .faq-item-home {
        background: white;
        margin-bottom: 15px;
        border-radius: 12px;
    }
    summary {
        padding: 20px;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        font-weight: 700;
        color: var(--neutral-gray-800);
    }
    .gold-plus {
        color: var(--color-gold);
    }
    .faq-ans {
        padding: 0 20px 20px;
        color: var(--neutral-gray-600);
    }

    /* FORMULÁRIO HOME */
    .contact-home {
        padding: 120px 0;
    }
    .contact-box-home {
        background: white;
        color: var(--neutral-gray-800);
        padding: 80px;
        border-radius: 40px;
        box-shadow: var(--shadow-medium);
        border: 1px solid var(--secondary-light);
    }
    .contact-header-home {
        text-align: center;
        margin-bottom: 50px;
    }
    .contact-header-home h2 {
        color: var(--neutral-gray-800);
        font-size: 3rem;
    }
    .h-form {
        max-width: 800px;
        margin: 0 auto;
    }
    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }
    .input-group {
        margin-bottom: 20px;
    }
    label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        font-size: 0.9rem;
    }
    input,
    select,
    textarea {
        width: 100%;
        padding: 15px;
        border-radius: 12px;
        border: 1px solid var(--secondary-light);
        background: var(--neutral-light);
        color: var(--neutral-black);
        font-family: inherit;
        outline: none;
    }
    input:focus,
    select:focus,
    textarea:focus {
        background: white;
        border-color: var(--primary-soft);
        box-shadow: 0 0 0 2px rgba(106, 140, 175, 0.1);
    }
    select option {
        background-color: white;
        color: var(--neutral-black);
    }
    input::placeholder,
    textarea::placeholder {
        color: var(--neutral-gray-600);
    }
    textarea {
        height: 120px;
        resize: none;
    }
    .counter {
        text-align: right;
        font-size: 0.8rem;
        opacity: 0.6;
        margin-top: 5px;
    }
    .gold-glow:hover {
        box-shadow: 0 0 20px rgba(197, 160, 89, 0.4);
    }
    .btn-primary {
        background-color: var(--primary-soft);
        color: white;
        width: 100%;
        padding: 18px;
        border-radius: 12px;
        font-size: 1.1rem;
        transition: var(--transition-smooth);
    }
    .btn-primary:hover {
        background-color: var(--primary-hover);
        transform: translateY(-2px);
    }

    @media (max-width: 992px) {
        .grid-3,
        .about-grid,
        .modalidades-grid,
        .feedback-grid-home,
        .form-row {
            grid-template-columns: 1fr;
        }
        .contact-box-home {
            padding: 40px 20px;
        }
    }
</style>

<script>
    function setupHomeForm() {
        const text = document.querySelector("textarea");
        const count = document.getElementById("char-count");
        const form = document.getElementById("home-contact-form");
        const status = document.getElementById("form-status");

        text?.addEventListener("input", () => {
            if (count) count.textContent = text.value.length.toString();
        });

        form?.addEventListener("submit", async (e) => {
            e.preventDefault();
            const btn = form.querySelector("button");
            if (btn) {
                btn.disabled = true;
                btn.textContent = "Enviando...";
            }

            // Simulação
            setTimeout(() => {
                if (status) {
                    status.textContent = "Mensagem enviada com sucesso!";
                    status.style.color = "#4ade80";
                    (form as HTMLFormElement).reset();
                    if (count) count.textContent = "0";
                }
                if (btn) {
                    btn.disabled = false;
                    btn.textContent = "Enviar Solicitação";
                }
            }, 2000);
        });
    }
    document.addEventListener("astro:page-load", setupHomeForm);
</script>
