---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const sections = [
    {
        title: "🎨 Identidade e Estética",
        desc: "O site foi construído sobre uma base de 'Luxury Branding'. Utilizamos azul marinho para transmitir confiança e o dourado (#b8860b) para sofisticação.",
        items: [
            "Tipografia: Rollgates Luxury (títulos) e Lato (leitura).",
            "Cores: Harmonia entre tons de azul e brilho dourado.",
            "Imagens: Filtros e composições que valorizam o profissionalismo.",
        ],
    },
    {
        title: "⚡ Estrutura do Site",
        desc: "O projeto é uma 'One Page' otimizada para levar o paciente do primeiro contato até o agendamento.",
        items: [
            "Hero: Primeira impressão impactante com fundo interativo.",
            "Especialidades: Cards com pré-preenchimento inteligente de formulário.",
            "Como Funciona: Passo a passo didático para o paciente.",
            "FAQ: Perguntas frequentes para reduzir objeções.",
            "Linktree: Página 'Links Úteis' para a bio do Instagram.",
        ],
    },
    {
        title: "🛠️ Tecnologia Utilizada",
        desc: "Usamos o **Astro.js**, uma das ferramentas mais modernas da atualidade.",
        items: [
            "Velocidade: O site carrega quase instantaneamente.",
            "Mobile First: Perfeito em qualquer celular ou tablet.",
            "Segurança: Código blindado contra ataques comuns.",
            "SEO: Otimizado para aparecer nos resultados do Google.",
        ],
    },
    {
        title: "🛡️ Propriedade e Independência",
        desc: "Garantimos a você o controle total e a propriedade intelectual de todo o seu ecossistema digital.",
        items: [
            "Patrimônio Digital: O código-fonte, design e textos pertencem 100% a você por contrato e ética profissional.",
            "Padrão de Qualidade: Utilizamos tecnologias globais (Astro + Tailwind), o que garante que qualquer desenvolvedor qualificado no mundo consiga dar continuidade ao seu projeto.",
            "Segurança Permanente: Seu projeto está versionado em nuvem (GitHub), funcionando como um cofre digital contra perdas de arquivos.",
        ],
    },
];
---

<Layout title="Manual do Projeto - Tatiane Miranda">
    <!-- Simplified Navigation for Manual -->
    <nav
        class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-primary/5 py-4"
    >
        <div class="container mx-auto px-4 flex items-center justify-between">
            <a href="/" class="flex items-center gap-3 group">
                <div
                    class="w-10 h-10 rounded-xl bg-primary/5 flex items-center justify-center group-hover:bg-primary/10 transition-colors"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#b8860b"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path
                            d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                        ></path><polyline points="9 22 9 12 15 12 15 22"
                        ></polyline></svg
                    >
                </div>
                <span class="font-heading text-lg text-primary hidden sm:block"
                    >Painel do Cliente</span
                >
            </a>

            <a
                href="/"
                class="flex items-center gap-2 bg-primary text-white px-5 py-2 rounded-full text-sm font-bold hover:shadow-lg hover:-translate-y-0.5 transition-all"
            >
                Voltar para o Site
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path
                        d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
                    ></path><polyline points="15 3 21 3 21 9"></polyline><line
                        x1="10"
                        y1="14"
                        x2="21"
                        y2="3"></line></svg
                >
            </a>
        </div>
    </nav>

    <main class="pt-32 pb-20 bg-brand-light/20 overflow-x-hidden">
        <div class="container mx-auto px-4 sm:px-6">
            {/* Header Manual */}
            <div class="max-w-4xl mx-auto text-center mb-16">
                <span
                    class="inline-block px-4 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-bold tracking-widest uppercase mb-4"
                >
                    Guia de Entrega e Suporte
                </span>
                <h1 class="font-heading text-4xl md:text-6xl text-primary mb-6">
                    Manual do seu <br /><span
                        class="text-[#b8860b] italic font-light">Novo Site</span
                    >
                </h1>
                <p
                    class="font-body text-lg text-muted-foreground leading-relaxed"
                >
                    Olá, Tatiane! Preparamos este manual didático para você
                    entender cada detalhe da ferramenta que acabamos de
                    construir para sua presença digital.
                </p>

                {/* Warning Card */}
                <div
                    class="mt-10 p-6 bg-amber-50 border-l-4 border-amber-400 rounded-r-2xl text-left"
                >
                    <div class="flex flex-col sm:flex-row gap-4">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-6 h-6 text-amber-500 shrink-0"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                            ></path>
                        </svg>
                        <div>
                            <h3 class="font-bold text-amber-800">
                                Importante: Esboço em Desenvolvimento
                            </h3>
                            <p class="text-amber-700 text-sm mt-1">
                                Este site ainda **não é o resultado final**.
                                Estamos na fase de ajustes finos. Todas as
                                solicitações de mudança que você fez estão sendo
                                aplicadas para garantir que a entrega seja 100%
                                perfeita.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            {/* Content Sections */}
            <div
                class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8"
            >
                {
                    sections.map((section) => (
                        <div class="bg-white p-6 sm:p-8 rounded-[30px] sm:rounded-[40px] shadow-sm border border-primary/5 hover:border-[#b8860b]/30 transition-all duration-300">
                            <h2 class="font-heading text-2xl text-primary mb-4">
                                {section.title}
                            </h2>
                            <p class="font-body text-muted-foreground mb-6 text-sm">
                                {section.desc}
                            </p>
                            <ul class="space-y-3">
                                {section.items.map((item) => (
                                    <li class="flex items-start gap-2 text-sm font-body text-foreground">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="w-5 h-5 text-[#b8860b] shrink-0"
                                            viewBox="0 0 20 20"
                                            fill="currentColor"
                                        >
                                            <path
                                                fill-rule="evenodd"
                                                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                                clip-rule="evenodd"
                                            />
                                        </svg>
                                        <span class="break-words">{item}</span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }

                {/* Repository Link Card */}
                <div
                    class="col-span-1 md:col-span-2 lg:col-span-2 bg-white p-6 sm:p-8 rounded-[30px] sm:rounded-[40px] shadow-sm border-2 border-dashed border-[#b8860b]/20 flex flex-col md:flex-row items-center justify-between gap-6"
                >
                    <div
                        class="flex flex-col sm:flex-row items-center sm:items-start gap-4"
                    >
                        <div
                            class="w-12 h-12 rounded-2xl bg-[#b8860b]/10 flex items-center justify-center shrink-0"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="#b8860b"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path
                                    d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
                                ></path><path d="M9 18c-4.51 2-5-2-7-2"
                                ></path></svg
                            >
                        </div>
                        <div class="min-w-0 flex-1 text-center sm:text-left">
                            <h3 class="font-heading text-xl text-primary">
                                Acesso ao Código-Fonte (Patrimônio Digital)
                            </h3>
                            <p
                                class="text-sm font-body text-muted-foreground mt-1"
                            >
                                Este link é a sua garantia de liberdade. Ele
                                contém toda a engenharia e o design do seu site.
                                Caso você deseje escalar sua operação ou precise
                                de manutenção externa no futuro, este
                                repositório permite que qualquer profissional da
                                tecnologia assuma o projeto com total segurança
                                e agilidade.
                            </p>
                            <p
                                class="text-xs font-body text-muted-foreground mt-2 break-all opacity-40 font-mono"
                            >
                                https://github.com/WalaceRamosdev/tatianemiranda-healing-hub
                            </p>
                        </div>
                    </div>
                    <a
                        href="https://github.com/WalaceRamosdev/tatianemiranda-healing-hub"
                        target="_blank"
                        class="w-full md:w-auto text-center px-6 py-3 rounded-full border-2 border-[#b8860b] text-[#b8860b] font-bold text-sm hover:bg-[#b8860b] hover:text-white transition-all whitespace-nowrap"
                    >
                        Ver Repositório
                    </a>
                </div>
                {/* Linktree Card */}
                <div
                    class="col-span-1 md:col-span-2 lg:col-span-2 bg-gradient-to-r from-primary to-primary/90 p-6 sm:p-8 rounded-[30px] sm:rounded-[40px] shadow-sm border border-white/10 flex flex-col md:flex-row items-center justify-between gap-6"
                >
                    <div
                        class="flex flex-col sm:flex-row items-center sm:items-start gap-4"
                    >
                        <div
                            class="w-12 h-12 rounded-2xl bg-white/10 flex items-center justify-center shrink-0"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="#b8860b"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path
                                    d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
                                ></path><path
                                    d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
                                ></path></svg
                            >
                        </div>
                        <div class="min-w-0 flex-1 text-center sm:text-left">
                            <h3 class="font-heading text-xl text-white">
                                Cartão de Visitas Digital (Linktree)
                            </h3>
                            <p class="text-sm font-body text-white/70 mt-1">
                                Desenvolvemos uma página exclusiva para sua Bio
                                do Instagram. Centralize todos os seus canais de
                                comunicação em um único link elegante e
                                profissional, totalmente integrado à sua nova
                                identidade visual.
                            </p>
                            <p
                                class="text-xs font-body text-[#b8860b] mt-2 font-mono"
                            >
                                Link de Acesso: /links
                            </p>
                        </div>
                    </div>
                    <a
                        href="/links"
                        target="_blank"
                        class="w-full md:w-auto text-center px-6 py-3 rounded-full bg-[#b8860b] text-white font-bold text-sm hover:scale-105 transition-all whitespace-nowrap"
                    >
                        Ver Página de Links
                    </a>
                </div>
            </div>

            {/* Support Message */}
            <div
                class="max-w-3xl mx-auto mt-12 sm:mt-20 p-6 sm:p-10 bg-primary rounded-[30px] sm:rounded-[50px] text-center text-white relative overflow-hidden group"
            >
                <canvas
                    id="manual-particles"
                    class="absolute inset-0 opacity-20 pointer-events-none"
                ></canvas>
                <div class="relative z-10">
                    <h2 class="font-heading text-3xl mb-4">Próximos Passos</h2>
                    <p
                        class="font-body opacity-80 mb-8 max-w-lg mx-auto leading-relaxed"
                    >
                        Continuamos trabalhando nos ajustes solicitados. Assim
                        que terminarmos, faremos a publicação final no seu
                        domínio oficial.
                    </p>
                    <a
                        href="https://wa.me/5521999064502"
                        target="_blank"
                        class="inline-flex items-center gap-2 bg-[#b8860b] text-white px-8 py-4 rounded-full font-bold hover:scale-105 transition-transform shadow-xl"
                    >
                        Acompanhar Alterações
                    </a>
                </div>
            </div>
        </div>
    </main>

    <Footer />
</Layout>

<script>
    function initManualParticles() {
        const canvas = document.getElementById(
            "manual-particles",
        ) as HTMLCanvasElement;
        if (!canvas) return;
        const ctx = canvas.getContext("2d");
        if (!ctx) return;
        const resize = () => {
            canvas.width = canvas.offsetWidth;
            canvas.height = canvas.offsetHeight;
        };
        window.addEventListener("resize", resize);
        resize();
        const particles: any[] = [];
        for (let i = 0; i < 30; i++)
            particles.push({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                vx: Math.random() * 0.4 - 0.2,
                vy: Math.random() * 0.4 - 0.2,
                s: Math.random() * 2,
            });
        function loop() {
            if (!ctx) return;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = "white";
            particles.forEach((p) => {
                p.x += p.vx;
                p.y += p.vy;
                if (p.x > canvas.width) p.x = 0;
                if (p.y > canvas.height) p.y = 0;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.s, 0, Math.PI * 2);
                ctx.fill();
            });
            requestAnimationFrame(loop);
        }
        loop();
    }
    initManualParticles();
</script>
